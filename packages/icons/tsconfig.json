// Standalone config (see packages/ui-atoms/tsconfig.json in this repo) — no shared
// `@tilli-pro/tsconfig` base.
// No `jsx` setting: this package has no `.tsx` sources today.
{
  "compilerOptions": {
    "strict": true,
    "rootDir": "./",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "${configDir}/.cache/typecheck.tsbuildinfo"
  },
  "include": ["src", "__tests__"]
}
