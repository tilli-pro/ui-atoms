{
  "name": "@tilli.dev/icons",
  "version": "0.0.0",
  "private": true,
  "description": "tilli icon set (scaffold — grows on the first real icon PR; lucide remains a ui-atoms dependency)",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public", "provenance": true },
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "peerDependencies": { "react": "^19.0.0" },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
