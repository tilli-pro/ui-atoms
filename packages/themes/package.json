{
  "name": "@tilli.dev/themes",
  "version": "1.0.0",
  "description": "Themes for @tilli.dev/ui-atoms: the tilli brand palette, beacon, which adds a spectrum for telling an application's sections apart, and nudge, the Nudge product's palette",
  "type": "module",
  "license": "MIT",
  "homepage": "https://tilli-pro.github.io/ui-atoms/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilli-pro/ui-atoms.git",
    "directory": "packages/themes"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    "./package.json": "./package.json",
    "./tilli.css": "./dist/tilli.css",
    "./tilli/tokens.css": "./dist/tilli/tokens.css",
    "./beacon.css": "./dist/beacon.css",
    "./beacon/tokens.css": "./dist/beacon/tokens.css",
    "./nudge.css": "./dist/nudge.css",
    "./nudge/tokens.css": "./dist/nudge/tokens.css"
  },
  "scripts": {
    "build": "rm -rf dist && cp -R src dist && cp ../../LICENSE .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tilli.dev/ui-atoms": "workspace:^",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "catalog:",
    "@tilli.dev/ui-atoms": "workspace:^",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
