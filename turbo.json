{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/THIRD-PARTY-NOTICES.md"
      ],
      "outputs": ["dist/**", "LICENSE", "THIRD-PARTY-NOTICES.md"]
    },
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^build"] },
    "dev:types": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "playground#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "with": ["@tilli.dev/ui-atoms#dev", "@tilli.dev/ui-atoms#dev:types"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "clean": { "cache": false }
  },
  "cacheMaxSize": "2GB"
}
