{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/THIRD-PARTY-NOTICES.md"
      ],
      "outputs": ["dist/**", "LICENSE", "THIRD-PARTY-NOTICES.md"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "clean": { "cache": false }
  }
}
